<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="flood_zone">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
    </light>

    <model name="flood_water">
      <static>true</static>
      <link name="water_link">
        <pose>0 0 -0.05 0 0 0</pose>
        <visual name="water_visual">
          <geometry><box><size>320 320 0.1</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.5 0.85</ambient>
            <diffuse>0.1 0.3 0.5 0.85</diffuse>
          </material>
        </visual>
        <collision name="water_collision">
          <geometry><box><size>320 320 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Sector 1 Survivors (Drone 1 Search Area: East in [-160, 30]) -->
    <model name="survivor_1">
      <static>true</static>
      <pose>-80 -110 0.05 0 0 0</pose>
      <include merge="true">
        <uri>model://person_walking</uri>
      </include>
    </model>

    <model name="survivor_8">
      <static>true</static>
      <pose>-130 -70 0.05 0 0 0.8</pose>
      <include merge="true">
        <uri>model://casual_female</uri>
      </include>
    </model>

    <model name="survivor_7">
      <static>true</static>
      <pose>60 -130 0.05 0 0 -1.2</pose>
      <include merge="true">
        <uri>model://person_walking</uri>
      </include>
    </model>

    <model name="survivor_10">
      <static>true</static>
      <pose>130 -90 0.05 0 0 2.1</pose>
      <include merge="true">
        <uri>model://person_walking</uri>
      </include>
    </model>

    <model name="survivor_4">
      <static>true</static>
      <pose>-30 -50 0.05 0 0 1.57</pose>
      <include merge="true">
        <uri>model://person_walking</uri>
      </include>
    </model>

    <!-- Sector 2 Survivors (Drone 2 Search Area: East in [30, 160]) -->
    <model name="survivor_5">
      <static>true</static>
      <pose>90 50 0.05 0 0 0.5</pose>
      <include merge="true">
        <uri>model://casual_female</uri>
      </include>
    </model>

    <model name="survivor_6">
      <static>true</static>
      <pose>-110 60 0.05 0 0 -0.7</pose>
      <include merge="true">
        <uri>model://person_standing</uri>
      </include>
    </model>

    <model name="survivor_9">
      <static>true</static>
      <pose>30 80 0.05 0 0 1.1</pose>
      <include merge="true">
        <uri>model://person_standing</uri>
      </include>
    </model>

    <model name="survivor_3">
      <static>true</static>
      <pose>-80 120 0.05 0 0 -2.4</pose>
      <include merge="true">
        <uri>model://person_standing</uri>
      </include>
    </model>

    <model name="survivor_2">
      <static>true</static>
      <pose>110 140 0.05 0 0 0</pose>
      <include merge="true">
        <uri>model://casual_female</uri>
      </include>
    </model>
<magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
 <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
   </sdf>
