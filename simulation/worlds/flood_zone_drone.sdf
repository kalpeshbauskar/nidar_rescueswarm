<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="flood_zone">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
    </light>

    <model name="flood_water">
      <static>true</static>
      <link name="water_link">
        <pose>0 0 -0.05 0 0 0</pose>
        <visual name="water_visual">
          <geometry><box><size>320 320 0.1</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.5 0.85</ambient>
            <diffuse>0.1 0.3 0.5 0.85</diffuse>
          </material>
        </visual>
        <collision name="water_collision">
          <geometry><box><size>320 320 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="debris_1"><static>true</static><pose>-120 -100 0.15 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>2 2 0.3</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><collision name="c"><geometry><box><size>2 2 0.3</size></box></geometry></collision></link></model>
    <model name="survivor_1"><static>true</static><pose>-120 -100 0.9 0 0 0</pose><link name="body"><visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.6</length></cylinder></geometry><material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual><collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.6</length></cylinder></geometry></collision></link></model>

